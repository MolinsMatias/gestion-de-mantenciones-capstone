{
  "expo": {
    "name": "Bowling Services",
    "slug": "bowling-services",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "light",
    "backgroundColor": "#07172C",
    "ios": {
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "package": "com.bowlingservices.mobile",
      "permissions": ["android.permission.VIBRATE"],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/icon.png",
      "name": "Bowling Services",
      "shortName": "Bowling",
      "description": "Gestión técnica de mantenciones de maquinaria para Bowling Services",
      "themeColor": "#07172C",
      "backgroundColor": "#07172C",
      "barStyle": "black-translucent",
      "display": "standalone",
      "orientation": "portrait",
      "lang": "es"
    },
    "plugins": [
      "expo-router",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false,
          "hidden": false,
          "style": "dark"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Permitir a $(PRODUCT_NAME) acceder a la cámara para escanear códigos QR de máquinas y equipos."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/logo.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a94753af-00ec-4180-9916-514201223229"
      }
    },
    "owner": "deyknw",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/a94753af-00ec-4180-9916-514201223229"
    }
  }
}
