{
  "expo": {
    "name": "Bowling Services",
    "slug": "bowling-services",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "light",
    "backgroundColor": "#f8fafc",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.bowlingservices.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "name": "Bowling Services",
      "shortName": "Bowling",
      "description": "Gestión técnica de mantenciones de maquinaria para Bowling Services",
      "themeColor": "#07162c",
      "backgroundColor": "#07162c",
      "display": "standalone",
      "orientation": "portrait",
      "lang": "es"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a94753af-00ec-4180-9916-514201223229"
      }
    },
    "owner": "deyknw",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/a94753af-00ec-4180-9916-514201223229"
    }
  }
}
